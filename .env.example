# Recall credentials and region must belong to the same workspace.
RECALL_API_KEY=
RECALL_API_BASE_URL=https://us-west-2.recall.ai/api/v1

# Deepgram project API key with access to streaming Flux STT and Voice Agent.
DEEPGRAM_API_KEY=
# OpenAI text model hosted by Deepgram for the Voice Agent's think stage.
DEEPGRAM_AGENT_MODEL=gpt-4o-mini
DEEPGRAM_AGENT_VOICE=aura-2-thalia-en

# Simli supplies the speaking avatar; use a face available to your account.
SIMLI_FACE_ID=14c60d62-6ebf-424d-b626-1f4f91c33b04
SIMLI_API_KEY=

# Public HTTPS origin tunneling to WebRTC signaling on localhost:7861.
# The launcher itself remains local on localhost:8001.
PIPECAT_PUBLIC_URL=
SESSION_TIMEOUT_SECONDS=600

# Optional ICE configuration for networks that need a TURN relay.
# Defaults to Google's public STUN server. Keep TURN credentials in .env.
# WEBRTC_ICE_SERVERS=[{"urls":"turn:relay.example.com:3478","username":"your-user","credential":"your-password"}]
